@ ===========================================================================
@ LCD_SendNibble   R0 bits 3:0 -> the four data lines
@ ===========================================================================
    .type LCD_SendNibble, %function
LCD_SendNibble:
    PUSH {R1, R2, R3, LR}
 80002b2:	b50e      	push	{r1, r2, r3, lr}
    @ TODO 8: Map the four bits of R0 onto the four data pins (across 3 ports).
    @   R0 bit 0 -> PB8   (D4)
    @   R0 bit 1 -> PB9   (D5)
    @   R0 bit 2 -> PA12  (D6)
    @   R0 bit 3 -> PA15  (D7)
    MOVS R1, #0              @ R1 = GPIOA BSRR value
 80002b4:	2100      	movs	r1, #0
    MOVS R2, #0              @ R2 = GPIOB BSRR value
 80002b6:	2200      	movs	r2, #0
@-------------------------------------------------------------------
    MOVS R3, #1
 80002b8:	2301      	movs	r3, #1
    TST  R0, R3             @ Test bit 0 of R0 if set for D4/ preserves
 80002ba:	4218      	tst	r0, r3
    BEQ  send_d4_low        @ if not set, branch to send_d4_low
 80002bc:	d002      	beq.n	80002c4 <send_d4_low>
    LSLS R3, R3, #8         @ D4 high: set PB8/ shift bit by 8 to set bit 8 in BSRR
 80002be:	021b      	lsls	r3, r3, #8
    ORRS R2, R3             @ OR R2 with R3 to set PB8 high
 80002c0:	431a      	orrs	r2, r3
    B    send_d5            @ on to the next bit
 80002c2:	e001      	b.n	80002c8 <send_d5>

