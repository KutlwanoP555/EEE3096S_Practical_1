        if (adc_val >= 4032) leds_to_light = 8;   // top edge: full scale = all 8

        /* Bar-graph pattern: n ones. (1<<3)-1 = 0b00000111 */
        uint8_t output_pattern = (1U << leds_to_light) - 1;

        /* Drive PB0-PB7 */
        write_led_byte(output_pattern);
    }
}

/* ---------- Helper: write an 8-bit pattern to PB0-PB7 ---------- */
static void write_led_byte(uint8_t pattern)
{
    uint32_t odr = GPIOB->ODR;
    odr &= ~(0xFFU);
    odr |= pattern;
    GPIOB->ODR = odr;
}