/* ---------- GPIO Configuration ---------- */
static void GPIO_Init(void)
{
    /* Enable clocks for GPIOA (analog pin) and GPIOB (LEDs) */
    RCC->AHBENR |= RCC_AHBENR_GPIOAEN | RCC_AHBENR_GPIOBEN;

    /* PA5 to Analog mode (11) for ADC_IN5 */
    GPIOA->MODER |= (3U << (5 * 2));

    /* PB0-PB7 as General purpose outputs (01), then clear ODR (all LEDs off) */
    for (uint8_t i = 0; i < 8; i++)
    {
        GPIOB->MODER &= ~(3U << (i * 2));   // clear the 2 mode bits
        GPIOB->MODER |=  (1U << (i * 2));   // set to 01 -> output
    }
    GPIOB->ODR &= ~0xFFU;
}

/* ---------- ADC Configuration ---------- */
static void ADC_Init(void)
{
    /* Enable APB2 clock for ADC1 */
    RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;

    /* Ensure ADC is disabled, then run calibration (ADC must be off to calibrate) */
    if (ADC1->CR & ADC_CR_ADEN)
    {
        ADC1->CR |= ADC_CR_ADDIS;
        while (ADC1->CR & ADC_CR_ADEN) {}
    }
    ADC1->CR |= ADC_CR_ADCAL;
    while (ADC1->CR & ADC_CR_ADCAL) {}      // hardware clears the bit when done

    /* Select channel 5 (PA5) and sampling time (41.5 cycles — plenty for DC) */
    ADC1->CHSELR = ADC_CHSELR_CHSEL5;
    ADC1->SMPR = 4;

    /* 12-bit resolution (default 00), right alignment (default 0), continuous mode */
    ADC1->CFGR1 = ADC_CFGR1_CONT;

    /* End-of-conversion interrupt: peripheral side + NVIC side */
    ADC1->IER |= ADC_IER_EOCIE;
    NVIC_SetPriority(ADC1_COMP_IRQn, 1);
    NVIC_EnableIRQ(ADC1_COMP_IRQn);

    /* Enable the ADC and wait until it reports ready */
    ADC1->CR |= ADC_CR_ADEN;
    while (!(ADC1->ISR & ADC_ISR_ADRDY)) {}
}

/* ---------- Interrupt Service Routine ---------- */
void ADC1_COMP_IRQHandler(void)
{
    if (ADC1->ISR & ADC_ISR_EOC)
    {
        /* Read the raw 12-bit value — reading DR also clears the EOC flag */
        uint32_t adc_val = ADC1->DR;

        /* Scale 0..4095 onto 0..8 LEDs (512 counts per LED) */
        uint8_t leds_to_light = (adc_val * 8) / 4096;
        if (adc_val >= 4032) leds_to_light = 8;   // top edge: full scale = all 8

        /* Bar-graph pattern: n ones. (1<<3)-1 = 0b00000111 */
        uint8_t output_pattern = (1U << leds_to_light) - 1;

        /* Drive PB0-PB7 */
        write_led_byte(output_pattern);
    }
}

/* ---------- Helper: write an 8-bit pattern to PB0-PB7 ---------- */
static void write_led_byte(uint8_t pattern)
{
    uint32_t odr = GPIOB->ODR;
    odr &= ~(0xFFU);
    odr |= pattern;
    GPIOB->ODR = odr;
